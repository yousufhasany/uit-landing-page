# ─── Database (PostgreSQL) ───
# Local development: `npm run db` starts an embedded PostgreSQL on port 5433 with these credentials.
DATABASE_URL="postgresql://uit:uit_local_dev@localhost:5433/uit"
TEST_DATABASE_URL="postgresql://uit:uit_local_dev@localhost:5433/uit_test"

# ─── Server ───
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ─── Authentication ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# lax works when the site and API share a site (same origin, or e.g. uit.edu.bd + api.uit.edu.bd).
# Use none only if they are on unrelated domains (forces Secure cookies).
COOKIE_SAME_SITE=lax

# ─── Cloudinary (optional locally; required in production) ───
# When empty, uploads are stored on local disk in server/storage/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uit

# Optional: where local (non-Cloudinary) uploads are written. Defaults to server/storage/uploads.
# UPLOAD_DIR=

# ─── Upload limits ───
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100

# ─── Bootstrap Super Admin (used only by the seed script) ───
# Created on first seed if no user with this email exists. Use a strong, unique password
# (10+ characters with upper and lower case letters and a number) and change it after first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME="UIT Super Admin"
