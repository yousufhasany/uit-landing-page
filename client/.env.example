# Public build-time settings only. Never put secrets here: every VITE_ variable is shipped to the browser.

# Base URL of the API when it is served from a different origin than the site (e.g. https://api.uit.edu.bd).
# Leave empty when the API is served from the same origin under /api (recommended; cookies stay first-party).
# On Vercel, leave this empty. Do not set it in the Vercel project.
VITE_API_URL=

# Development only: where the Vite dev server proxies /api, /uploads, /sitemap.xml and /robots.txt.
VITE_DEV_API_TARGET=http://localhost:4000
